<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Run inside the App Sandbox: notes live in the app's own container. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Files the person picks in Open/Save panels or drops on the window. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- File > Print. -->
    <key>com.apple.security.print</key>
    <true/>
    <!-- Sparkle's installer XPC services (in-app updates). -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>local.rubbishnotes.app-spks</string>
        <string>local.rubbishnotes.app-spki</string>
    </array>
</dict>
</plist>
